# Copy this file to .env.local for local dev with `vercel dev`
# In production, set these in Vercel Dashboard → Project Settings → Environment Variables

# Binance API (Read-Only) — create at https://www.binance.com/en/my/settings/api-management
# IMPORTANT: Enable ONLY "Enable Reading". Do NOT enable trading or withdrawals.
BINANCE_API_KEY=your_read_only_api_key_here
BINANCE_API_SECRET=your_read_only_api_secret_here

# Groq API (FREE) — from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Telegram Bot — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# CORS — restrict API endpoints to your deployed frontend only (security)
# Set this to your Vercel URL, e.g. https://btc-options-desk-xxxx.vercel.app
# Leave blank during local dev (falls back to * automatically)
ALLOWED_ORIGIN=https://your-app.vercel.app

# Protect all private dashboard APIs. Use a long random value and enter it once in the Dashboard.
APP_ACCESS_TOKEN=replace_with_a_long_random_dashboard_token

# Required by /api/cron. Vercel sends this automatically as Authorization: Bearer <secret>.
CRON_SECRET=replace_with_a_different_random_cron_secret

# Public URL used in Telegram buttons
APP_URL=https://your-app.vercel.app

# Optional but recommended for persistent Cron cooldown/idempotency (Vercel KV or Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Server-side Cron preferences (browser localStorage preferences do not control Cron)
CRON_ALERTS_ENABLED=true
CRON_DAILY_BRIEFING_ENABLED=true
