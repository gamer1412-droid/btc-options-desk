# Copy this file to .env.local for local dev with `vercel dev`
# In production, set these in Vercel Dashboard → Project Settings → Environment Variables

# Binance API (Read-Only) — create at https://www.binance.com/en/my/settings/api-management
# IMPORTANT: Enable ONLY "Enable Reading". Do NOT enable trading or withdrawals.
BINANCE_API_KEY=your_read_only_api_key_here
BINANCE_API_SECRET=your_read_only_api_secret_here

# Groq API (FREE) — from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Telegram Bot — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
